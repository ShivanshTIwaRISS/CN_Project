# ─────────────────────────────────────────────────────────────────────────────
# nginx/phase2-standby.conf.example
# Phase 2 — Standby Edge Reverse Proxy (Mac 1: 10.7.19.246)
#
# Runs on Mac 1 (Shivansh Tiwari).
# Used during Extension E (Controlled Edge Migration / DNS Cutover).
#
# Features:
#   - Listens on port 8443 with identical TLS certificate and domain names
#   - Proxies incoming HTTPS requests to local Backend A (127.0.0.1:3001)
# ─────────────────────────────────────────────────────────────────────────────

worker_processes 1;

pid /tmp/cn-nginx-standby.pid;
error_log /tmp/cn-nginx-standby-error.log notice;

events {
    worker_connections 1024;
}

http {
    access_log /tmp/cn-nginx-standby-access.log;

    upstream standby_backend {
        # Backend A running locally on Mac 1
        server 127.0.0.1:3001 max_fails=1 fail_timeout=10s;
    }

    server {
        listen 8443 ssl;
        server_name app.team1.test api.team1.test;

        # TLS Certificates (identical edge-cert.pem copied from Mac 2 or generated by trusted root)
        ssl_certificate     /Users/USERNAME/cn-project/certs/edge-cert.pem;
        ssl_certificate_key /Users/USERNAME/cn-project/certs/edge-key.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        location / {
            proxy_pass http://standby_backend;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            proxy_connect_timeout 2s;
            proxy_read_timeout 10s;
        }
    }
}
