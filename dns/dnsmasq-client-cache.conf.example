# ─────────────────────────────────────────────────────────────────────────────
# dns/dnsmasq-client-cache.conf.example
# Phase 2 Extension B — Local Caching Resolver Configuration (Mac 1)
#
# Runs on Mac 1 on an isolated non-privileged port (5300) to explicitly
# isolate and measure DNS cache behavior, TTL decrement, and cache flushing.
#
# Start standalone instance:
#   dnsmasq --conf-file=dns/dnsmasq-client-cache.conf.example
#
# Query cache:
#   dig @127.0.0.1 -p 5300 app.team1.test
#
# Flush cache (send SIGHUP):
#   kill -HUP $(cat /tmp/cn-dns-client-cache.pid)
# ─────────────────────────────────────────────────────────────────────────────

port=5300
listen-address=127.0.0.1
bind-interfaces

# Do not read /etc/resolv.conf
no-resolv

# Forward queries exclusively to the Primary Authoritative DNS on Mac 1
server=10.7.19.246#53

# Cache up to 1000 names
cache-size=1000

# Process tracking and query logging
pid-file=/tmp/cn-dns-client-cache.pid
log-queries
log-facility=/tmp/cn-dns-client-cache.log
