# ─────────────────────────────────────────────
# .gitignore — Phase 1 Private Network Platform
# ─────────────────────────────────────────────

# ── macOS ────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Node.js ──────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── SSL / TLS certificates & keys ────────────
# NEVER commit real private keys or self-signed
# certs that contain your private key material.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
ssl/
certs/

# ── Environment / secrets ────────────────────
.env
.env.*
*.secret

# ── Logs ─────────────────────────────────────
*.log
logs/
log/

# ── Temporary / editor files ─────────────────
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
