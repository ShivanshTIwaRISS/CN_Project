# ─────────────────────────────────────────────────────────────────────────────
# dns/dnsmasq.conf.example
# Phase 1 / Phase 2 Baseline — Private Network Service Platform
#
# Primary DNS server configuration template for Mac 1 (Shivansh Tiwari).
# The live configuration may be placed at:
#   /opt/homebrew/etc/dnsmasq.conf   (Apple-Silicon Homebrew)
#   /usr/local/etc/dnsmasq.conf      (Intel Homebrew)
#
# Restart dnsmasq:
#   sudo brew services restart dnsmasq
# ─────────────────────────────────────────────────────────────────────────────

# Listen on port 53 (standard DNS)
port=53

# Bind only to the LAN interface and loopback.
# en0 is the typical Wi-Fi interface on macOS.
interface=en0
bind-interfaces
listen-address=127.0.0.1,10.7.19.246

# ── Private .test zone ────────────────────────────────────────────────────────
# We use .test intentionally:
#   • .test is reserved by RFC 2606 / RFC 6761 for testing — it will never
#     collide with a real public TLD.
#   • .local MUST NOT be used; macOS reserves .local for mDNS/Bonjour.
#
# Both hostnames resolve to Mac 2 (nginx HTTPS reverse proxy: 10.7.18.254),
# NOT directly to the backend servers.
#
# Lab addresses:
#   Mac 1 (DNS Primary / Standby Edge / Backend A): 10.7.19.246
#   Mac 2 (DNS Backup / Active Edge / Backend B):    10.7.18.254
address=/app.team1.test/10.7.18.254
address=/api.team1.test/10.7.18.254

# DNS TTL (Extension B default: 30 seconds)
local-ttl=30

# ── Upstream forwarders for all other domains ─────────────────────────────────
server=1.1.1.1
server=8.8.8.8

# ── Logging ───────────────────────────────────────────────────────────────────
log-queries
log-facility=/tmp/dnsmasq.log
