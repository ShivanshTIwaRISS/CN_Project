# ─────────────────────────────────────────────────────────────────────────────
# nginx/phase1.conf.example
# Phase 1 Template — Private Network Service Platform
# ─────────────────────────────────────────────────────────────────────────────
#
# Replace placeholders with your values before use.
#
# <MAC1_IP>   — LAN IP of Mac 1 (runs dnsmasq + Backend A, e.g., 10.7.19.246)
# <MAC2_IP>   — LAN IP of Mac 2 (runs nginx + Backend B, e.g., 10.7.18.254)
# <USERNAME>  — your macOS login username
# ─────────────────────────────────────────────────────────────────────────────

upstream backends {
    server <MAC1_IP>:3001;   # Backend A
    server <MAC2_IP>:3002;   # Backend B
}

server {
    listen 8443 ssl;
    server_name app.team1.test api.team1.test;

    ssl_certificate     /Users/<USERNAME>/cn-project/certs/edge-cert.pem;
    ssl_certificate_key /Users/<USERNAME>/cn-project/certs/edge-key.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://backends;

        proxy_set_header Host             $host;
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
    }
}
